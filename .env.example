# Required before the first production start. Also used only when the server
# creates the admin record for the first time. Change it later in Admin Settings.
# Development falls back to 1234 only when this is unset.
ADMIN_PIN=1234

# Recommended in production. Long, random value used to sign admin session cookies.
# If omitted in production, a persistent secret is generated in the data directory.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional directory for the JSON data store. Must be writable and persistent.
# Defaults to ./.data when launched with `npm start` or `npm run dev`.
# DATA_DIR=./.data

# Set to true only when the server is behind a trusted proxy that overwrites
# X-Forwarded-For. Leave false when clients connect directly.
# TRUST_PROXY=false
